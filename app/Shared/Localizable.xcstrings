    "Cheapest hours explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheapest hours show the most affordable upcoming time windows. \"Must end before\" sets when the window must finish — e.g. 07:00 for overnight charging."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Odavad tunnid näitavad järgmistest tundidest kõige soodsamaid ajavahemikke. \"Lõpeb hiljemalt\" määrab kellaaja, milleks aken peab lõpetatud olema – näiteks 07:00 öiseks laadimiseks."
          }
        }
      }
    },
